{
  "name": "simplesight",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "node scripts/dev.mjs",
    "dev:turbo": "turbo dev --filter=@simplesight/marketing --filter=@simplesight/portal --filter=@simplesight/renderer",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "pnpm --filter @simplesight/db db:generate",
    "db:migrate": "pnpm --filter @simplesight/db db:migrate",
    "db:studio": "pnpm --filter @simplesight/db db:studio",
    "db:seed": "pnpm --filter @simplesight/db db:seed"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "@biomejs/biome": "^1.9.0"
  }
}
