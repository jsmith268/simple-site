{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "NODE_ENV",
        "DATABASE_URL",
        "AI_GATEWAY_API_KEY",
        "ANTHROPIC_API_KEY",
        "OPENAI_API_KEY",
        "VERCEL_OIDC_TOKEN",
        "BLOB_READ_WRITE_TOKEN",
        "CLERK_SECRET_KEY",
        "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
        "RESEND_API_KEY",
        "PADDLE_API_KEY",
        "PADDLE_WEBHOOK_SECRET",
        "PADDLE_ENV",
        "PADDLE_PRICE_BUILD_FEE",
        "PADDLE_PRICE_HOSTING_MONTHLY",
        "PADDLE_PRICE_HOSTING_ANNUAL",
        "NEXT_PUBLIC_PADDLE_CLIENT_TOKEN",
        "NEXT_PUBLIC_PADDLE_ENV",
        "NEXT_PUBLIC_PADDLE_PRICE_BUILD_FEE",
        "NEXT_PUBLIC_PADDLE_PRICE_HOSTING_MONTHLY",
        "NEXT_PUBLIC_PADDLE_PRICE_HOSTING_ANNUAL",
        "VERCEL_API_TOKEN",
        "VERCEL_TEAM_ID",
        "VERCEL_RENDERER_PROJECT_ID",
        "FIRECRAWL_API_KEY",
        "EXA_API_KEY",
        "UNSPLASH_ACCESS_KEY",
        "PEXELS_API_KEY",
        "ROOT_DOMAIN",
        "CRON_SECRET",
        "LOG_LEVEL",
        "SIMPLESIGHT_OFFLINE",
        "NEXT_PUBLIC_ROOT_DOMAIN",
        "NEXT_PUBLIC_APP_ENV"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {},
    "db:generate": { "cache": false },
    "db:migrate": { "cache": false },
    "db:studio": { "cache": false, "persistent": true },
    "db:seed": { "cache": false }
  }
}
