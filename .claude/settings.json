{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.ssh/*)",
      "Read(~/.aws/**)",
      "Read(~/.aws/*)",
      "Read(~/.gnupg/*)",
      "Read(~/.kube/*)",
      "Read(~/.docker/config.json)",
      "Read(~/.npmrc)",
      "Read(~/.netrc)",
      "Read(~/.config/gh/*)",
      "Read(~/.env)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/*)",
      "Read(../*)",
      "Write(../*)",
      "Edit(../*)",
      "Read(/etc/*)",
      "Write(/etc/*)",
      "Edit(/etc/*)",
      "Bash(sudo *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf .git)",
      "Bash(rm -rf .git/*)",
      "Bash(rm -rf .claude)",
      "Bash(rm -rf .claude/*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --delete *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fd*)",
      "Bash(git branch -D *)",
      "Bash(chmod -R 777 *)",
      "Bash(crontab *)",
      "Bash(launchctl *)",
      "Bash(systemctl *)",
      "Bash(dd if=*)",
      "Bash(mkfs*)",
      "Bash(shutdown *)",
      "Bash(reboot*)",
      "Bash(npm publish*)",
      "Bash(*headless: false*)",
      "Bash(*headless:false*)",
      "Bash(*--headed*)",
      "Bash(*playwright codegen*)",
      "Bash(*playwright open*)",
      "Bash(PWDEBUG=1*)",
      "Bash(*xargs -P 0*)",
      "Bash(*xargs -P0*)",
      "Bash(*vitest --watch*)",
      "Bash(*vitest watch*)",
      "Bash(*jest --watch*)",
      "Bash(*jest --watchAll*)",
      "Bash(yes)",
      "Bash(yes *)",
      "Bash(find / *)",
      "Bash(grep -r * /)",
      "Bash(rg * /)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/pranayramash/.claude/scripts/cc-watchdog-start.sh"
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/pranayramash/.claude/scripts/cc-watchdog-start.sh"
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/pranayramash/.claude/scripts/cc-watchdog-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/pranayramash/.claude/scripts/cc-bash-demote.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
