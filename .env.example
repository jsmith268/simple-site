# ── SimpleSight environment ───────────────────────────────────────────────
# Copy to .env and fill in. Anything left blank falls back to OFFLINE behavior
# (mocked agents, in-memory/no external calls) so the whole system runs locally.

# Set to "1" to force offline mode even if keys are present (deterministic mocks).
SIMPLESIGHT_OFFLINE=1

# Core
NODE_ENV=development
LOG_LEVEL=info
ROOT_DOMAIN=simplesight.co
NEXT_PUBLIC_ROOT_DOMAIN=simplesight.co
NEXT_PUBLIC_APP_ENV=development

# Database (Neon Postgres). Leave blank for offline mode (no DB writes).
DATABASE_URL=

# AI — Vercel AI Gateway preferred (OIDC), else direct keys.
AI_GATEWAY_API_KEY=
VERCEL_OIDC_TOKEN=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Storage (Vercel Blob) — customer asset uploads + large artifacts.
BLOB_READ_WRITE_TOKEN=

# Auth (Clerk)
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Billing (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_BUILD_FEE=
STRIPE_PRICE_HOSTING_MONTHLY=
STRIPE_PRICE_HOSTING_ANNUAL=

# Provisioning (Vercel API — deploys, domains, DNS)
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
VERCEL_RENDERER_PROJECT_ID=

# Research / extraction (optional — for crawling a customer's existing site)
FIRECRAWL_API_KEY=
EXA_API_KEY=

# Stock imagery (optional — gap-fill when customer photos are insufficient)
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# Cron / internal auth
CRON_SECRET=
